{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OTel Lab — Dashboard de SLIs y observabilidad. 6 paneles: Request Rate, Error Rate, Latency p99, Active Requests, DB Operation Duration, OTel Collector Health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "📊 SLI — Request Rate (req/s)",
      "description": "Tasa de requests HTTP por servicio. SLI de throughput.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_request_duration_milliseconds_count{job=\"otel-services\"}[1m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"otel-services\"}[1m])) by (service_name)",
          "legendFormat": "{{service_name}} (s)",
          "refId": "B",
          "hide": false
        }
      ]
    },
    {
      "id": 2,
      "title": "🚨 SLI — Error Rate (%)",
      "description": "Porcentaje de requests con codigo HTTP 5xx. SLI de disponibilidad. Umbral: < 1%.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_request_duration_milliseconds_count{http_response_status_code=~\"5..\",job=\"otel-services\"}[5m])) by (service_name) / sum(rate(http_server_request_duration_milliseconds_count{job=\"otel-services\"}[5m])) by (service_name)",
          "legendFormat": "error rate — {{service_name}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(business_errors_total{job=\"otel-services\"}[5m])) by (service_name, reason)",
          "legendFormat": "biz error — {{service_name}} / {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "⏱️ SLI — Latencia p50 / p95 / p99 (ms)",
      "description": "Percentiles de latencia HTTP. SLI de latencia. Objetivo p99 < 500ms.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_milliseconds_bucket{job=\"otel-services\"}[5m])) by (le, service_name))",
          "legendFormat": "p50 — {{service_name}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_milliseconds_bucket{job=\"otel-services\"}[5m])) by (le, service_name))",
          "legendFormat": "p95 — {{service_name}}",
          "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_milliseconds_bucket{job=\"otel-services\"}[5m])) by (le, service_name))",
          "legendFormat": "p99 — {{service_name}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "🔄 SLI — Active Requests (Saturacion)",
      "description": "Requests HTTP activos concurrentes. SLI de saturacion del sistema.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(http_server_active_requests{job=\"otel-services\"}) by (service_name)",
          "legendFormat": "active reqs — {{service_name}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(orders_created_total{job=\"otel-services\"}[1m])) by (service_name)",
          "legendFormat": "orders/min — {{service_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "🗄️ CPU Usage — OTel Collector",
      "description": "CPU consumido por el OTel Collector. Permite medir overhead de instrumentacion.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "rate(otelcol_process_cpu_seconds{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "Collector CPU",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "otelcol_process_memory_rss{job=\"otel-collector-internal\"} / 1024 / 1024",
          "legendFormat": "Collector RAM (MB)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "⚠️ OTel Collector — Errores y Drops",
      "description": "Spans y metricas descartados por el OTel Collector. Indicador de salud del pipeline de telemetria.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"otel-collector-internal\"}[5m])) by (exporter)",
          "legendFormat": "spans fallidos — {{exporter}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"otel-collector-internal\"}[5m])) by (exporter)",
          "legendFormat": "metricas fallidas — {{exporter}}",
          "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(otelcol_processor_dropped_spans_total{job=\"otel-collector-internal\"}[5m])) by (processor)",
          "legendFormat": "spans dropped — {{processor}}",
          "refId": "C"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"otel-collector-internal\"}[1m])) by (receiver)",
          "legendFormat": "spans aceptados — {{receiver}}",
          "refId": "D"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["otel", "sli", "microservices", "observability"],
