  "description": "Dashboard para el equipo de Operaciones (Ops): Comparativa de 30 minutos en 2 épocas de 15 min (Sin correlación vs Con correlación de anomalías) con Chaos Engineering y Simulador de Avalancha de Notificaciones.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Época Operativa Activa (15 Min / Época)",
      "description": "1 = Época 1 (Sistema Estático Tradicional - Avalancha de Alertas), 2 = Época 2 (Sistema Correlacionado Inteligente)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ÉPOCA 1: Estática (Ruido)", "color": "orange" },
                "2": { "text": "ÉPOCA 2: Correlación (Limpio)", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "anomaly_detector_active_epoch or vector(1)",
          "refId": "A"
        }
      ]
    },
    {
