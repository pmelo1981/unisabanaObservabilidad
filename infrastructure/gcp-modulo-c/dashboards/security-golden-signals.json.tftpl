{
  "displayName": "Golden Signals de Seguridad — OTel Lab (Modulo C)",
  "dashboardFilters": [],
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 12, "height": 1,
        "widget": {
          "title": "Golden Signals de Seguridad",
          "text": {
            "content": "**Autenticacion fallida** · **Trafico N-S / E-W** · **CVEs activos** — Fuentes: VPC Flow Logs, firewall logs, Cloud Audit Logs, access logs de Envoy y Artifact Analysis. Ventana de agregacion: 5 min.",
            "format": "MARKDOWN"
          }
        }
      },

      {
        "xPos": 0, "yPos": 1, "width": 3, "height": 4,
        "widget": {
          "title": "Auth fallida — plano de control (5 min)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/security/failed_auth_control_plane\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_DELTA",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [
              { "value": ${failed_auth_threshold}, "color": "YELLOW", "direction": "ABOVE" }
            ]
          }
        }
      },
      {
        "xPos": 3, "yPos": 1, "width": 3, "height": 4,
        "widget": {
          "title": "Auth fallida — mesh 401/403 (5 min)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/security/failed_auth_workload\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_DELTA",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [
              { "value": ${failed_auth_threshold}, "color": "YELLOW", "direction": "ABOVE" }
            ]
          }
        }
      },
      {
        "xPos": 6, "yPos": 1, "width": 3, "height": 4,
        "widget": {
          "title": "Conexiones denegadas (5 min)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/security/firewall_denied\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_DELTA",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "sparkChartView": { "sparkChartType": "SPARK_BAR" },
            "thresholds": [
              { "value": ${denied_threshold}, "color": "RED", "direction": "ABOVE" }
            ]
          }
        }
      },
      {
        "xPos": 9, "yPos": 1, "width": 3, "height": 4,
        "widget": {
          "title": "CVEs criticos activos",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"custom.googleapis.com/otel/security.cves.active\" metric.label.severity=\"CRITICAL\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_MAX",
                  "crossSeriesReducer": "REDUCE_SUM"
                }
              }
            },
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [
              { "value": 0, "color": "RED", "direction": "ABOVE" }
            ]
          }
        }
      },

      {
        "xPos": 0, "yPos": 5, "width": 6, "height": 4,
        "widget": {
          "title": "Golden Signal 1 — Intentos de autenticacion fallidos",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "legendTemplate": "control-plane · $${metric.label.service}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/failed_auth_control_plane\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.service"]
                    }
                  }
                }
              },
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "legendTemplate": "mesh · $${metric.label.response_code} $${metric.label.response_flags}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/failed_auth_workload\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.response_code", "metric.label.response_flags"]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "intentos / 5 min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 5, "width": 6, "height": 4,
        "widget": {
          "title": "Conexiones denegadas por regla y puerto destino",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "legendTemplate": "$${metric.label.rule} :$${metric.label.dest_port}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/firewall_denied\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.rule", "metric.label.dest_port"]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "denegaciones / 5 min", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 9, "width": 6, "height": 4,
        "widget": {
          "title": "Golden Signal 2 — Trafico Norte-Sur (entrante vs saliente)",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "ingress desde $${metric.label.src_country}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_ingress_internet\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.src_country"]
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "egress hacia $${metric.label.dest_country} (ASN $${metric.label.dest_asn})",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_egress_internet\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.dest_country", "metric.label.dest_asn"]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "flujos / 5 min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 9, "width": 6, "height": 4,
        "widget": {
          "title": "Golden Signal 2 — Trafico Este-Oeste por par de namespaces",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "legendTemplate": "$${metric.label.src_namespace} -> $${metric.label.dest_namespace}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_east_west\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.src_namespace", "metric.label.dest_namespace"]
                    }
                  }
                }
              },
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "legendTemplate": "NO AUTORIZADO :$${metric.label.dest_port}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_unexpected_pair\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.dest_port"]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "flujos / 5 min", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 13, "width": 6, "height": 4,
        "widget": {
          "title": "Volumen por flujo — p50 vs p99 (deteccion de exfiltracion)",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "E-W p50",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_east_west_bytes\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50",
                      "crossSeriesReducer": "REDUCE_MAX"
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "E-W p99",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_east_west_bytes\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MAX"
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "egress Internet p99",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/security/flow_egress_internet_bytes\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MAX"
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "bytes por flujo", "scale": "LOG10" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 13, "width": 6, "height": 4,
        "widget": {
          "title": "Golden Signal 3 — CVEs activos por severidad",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "legendTemplate": "$${metric.label.severity}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"custom.googleapis.com/otel/security.cves.active\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_MAX",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.severity"]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "CVEs sin corregir", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 17, "width": 6, "height": 4,
        "widget": {
          "title": "Estado de la alerta SEC-2 (trafico E-W no autorizado)",
          "alertChart": { "name": "${alert_unexpected_pair}" }
        }
      },
      {
        "xPos": 6, "yPos": 17, "width": 6, "height": 4,
        "widget": {
          "title": "Estado de la alerta SEC-5 (egress anomalo)",
          "alertChart": { "name": "${alert_anomalous_egress}" }
        }
      },

      {
        "xPos": 0, "yPos": 21, "width": 12, "height": 5,
        "widget": {
          "title": "Eventos de seguridad recientes (flujos denegados y auth fallida)",
          "logsPanel": {
            "resourceNames": ["projects/${project_id}"],
            "filter": "(log_id(\"compute.googleapis.com/firewall\") AND jsonPayload.disposition=\"DENIED\") OR ((log_id(\"cloudaudit.googleapis.com/activity\") OR log_id(\"cloudaudit.googleapis.com/data_access\")) AND (protoPayload.status.code=7 OR protoPayload.status.code=16))"
          }
        }
      }
    ]
  }
}
